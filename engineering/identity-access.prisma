generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — §4 Attribute Catalogue
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("user_status")
}

enum LockoutReason {
  NONE
  FAILED_ATTEMPTS
  ADMIN_ACTION
  SECURITY_CONCERN

  @@map("lockout_reason")
}

enum MFAMethod {
  TOTP
  SMS
  EMAIL
  HARDWARE_KEY
  BACKUP_CODES

  @@map("mfa_method")
}

enum AuthenticationProviderType {
  KEYCLOAK
  AZURE_AD
  GOOGLE_IDENTITY
  GENERIC_OIDC
  GENERIC_OAUTH
  LOCAL

  @@map("authentication_provider_type")
}

enum RoleType {
  PLATFORM_TEMPLATE
  CUSTOM

  @@map("role_type")
}

enum RoleAssignmentSource {
  MANUAL
  IMPORT
  TEMPLATE
  INVITATION
  DELEGATION

  @@map("role_assignment_source")
}

enum RolePermissionSource {
  DIRECT
  GROUP
  TEMPLATE

  @@map("role_permission_source")
}

enum PermissionEffect {
  ALLOW

  @@map("permission_effect")
}

enum SessionTerminationReason {
  USER_LOGOUT
  ADMIN_TERMINATED
  EXPIRED
  SECURITY

  @@map("session_termination_reason")
}

enum DelegationStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
  EXPIRED
  REVOKED

  @@map("delegation_status")
}

enum InvitationStatus {
  CREATED
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
  RESENT

  @@map("invitation_status")
}

enum AuthenticationEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  MFA_VERIFICATION_SUCCESS
  MFA_VERIFICATION_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_CREATED
  SESSION_TERMINATED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  MFA_ENABLED
  MFA_DISABLED

  @@map("authentication_event_type")
}

// ---------------------------------------------------------------------------
// Models — Identity: users (§3.1, §4.1)
// ---------------------------------------------------------------------------

model User {
  id                  String      @id @default(uuid()) @db.Uuid @map("id")
  institutionId       String?     @db.Uuid @map("institution_id")
  email               String      @db.VarChar(255) @map("email")
  status              UserStatus  @default(INVITED) @map("status")
  lastLoginAt         DateTime?   @map("last_login_at")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntilAt       DateTime?   @map("locked_until_at")
  studentId           String?     @db.Uuid @map("student_id")
  staffId             String?     @db.Uuid @map("staff_id")
  parentId            String?     @db.Uuid @map("parent_id")
  applicantId         String?     @db.Uuid @map("applicant_id")
  archivedAt          DateTime?   @map("archived_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  createdBy           String?     @db.Uuid @map("created_by")

  // Relations — Authentication
  authenticationAccount? AuthenticationAccount @relation(fields: [id], references: [userId], onDelete: Cascade)
  mfaConfigurations      MFAConfiguration[]
  trustedDevices         TrustedDevice[]
  passwordResetTokens    PasswordResetToken[]
  passwordHistories      PasswordHistory[]
  authenticationMethods  AuthenticationMethod[]

  // Relations — Authorization
  roleAssignments  RoleAssignment[]
  userPermissions  UserPermission[]
  delegationsAsGrantor Delegation[] @relation("DelegationGrantor")
  delegationsAsDelegate Delegation[] @relation("DelegationDelegate")
  delegationsApprovedBy Delegation[] @relation("DelegationApprover")
  delegationsRevokedBy  Delegation[] @relation("DelegationRevoker")

  // Relations — Sessions
  sessions Session[]
  sessionsTerminatedBy Session[] @relation("SessionTerminator")

  // Relations — Invitations
  invitationsSent  Invitation[] @relation("InvitationInviter")
  invitationsOwned Invitation[] @relation("InvitationUser")

  // Relations — Authentication Events
  authenticationEvents AuthenticationEvent[]

  @@unique([institutionId, email], map: "uk_users_institution_email")
  @@index([institutionId, status], map: "idx_users_institution_status")
  @@index([institutionId, lastLoginAt], map: "idx_users_institution_last_login")
  @@index([createdBy], map: "idx_users_created_by")
  @@index([studentId], map: "idx_users_student_id")
  @@index([staffId], map: "idx_users_staff_id")
  @@index([parentId], map: "idx_users_parent_id")
  @@index([applicantId], map: "idx_users_applicant_id")
  @@map("users")
}

// ---------------------------------------------------------------------------
// Models — Authentication: authentication_accounts (§3.2, §4.2)
// ---------------------------------------------------------------------------

model AuthenticationAccount {
  id                String        @id @default(uuid()) @db.Uuid @map("id")
  userId            String        @unique @db.Uuid @map("user_id")
  mfaEnabled        Boolean       @default(false) @map("mfa_enabled")
  lockoutReason     LockoutReason @default(NONE) @map("lockout_reason")
  lockoutExpiresAt  DateTime?     @map("lockout_expires_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaConfigurations   MFAConfiguration[]
  trustedDevices      TrustedDevice[]
  passwordResetTokens PasswordResetToken[]
  passwordHistories   PasswordHistory[]
  authenticationMethods AuthenticationMethod[]

  @@index([userId], map: "idx_auth_accounts_user_id")
  @@map("authentication_accounts")
}

// ---------------------------------------------------------------------------
// Models — Authentication: mfa_configurations (§3.3, §4.3)
// ---------------------------------------------------------------------------

model MFAConfiguration {
  id                     String    @id @default(uuid()) @db.Uuid @map("id")
  authenticationAccountId String   @db.Uuid @map("authentication_account_id")
  method                 MFAMethod @map("method")
  secret                 String?   @db.VarChar(500) @map("secret")
  enabled                Boolean   @default(false) @map("enabled")
  enrolledAt             DateTime  @map("enrolled_at")
  lastVerifiedAt         DateTime? @map("last_verified_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id], onDelete: Cascade)

  @@index([authenticationAccountId], map: "idx_mfa_config_account_id")
  @@map("mfa_configurations")
}

// ---------------------------------------------------------------------------
// Models — Authentication: trusted_devices (§3.4, §4.4)
// ---------------------------------------------------------------------------

model TrustedDevice {
  id                     String    @id @default(uuid()) @db.Uuid @map("id")
  authenticationAccountId String   @db.Uuid @map("authentication_account_id")
  deviceFingerprint      String    @db.VarChar(500) @map("device_fingerprint")
  deviceName             String?   @db.VarChar(255) @map("device_name")
  firstSeenAt            DateTime  @map("first_seen_at")
  lastSeenAt             DateTime  @map("last_seen_at")
  trustedAt              DateTime  @map("trusted_at")
  expiresAt              DateTime? @map("expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id], onDelete: Cascade)

  @@unique([authenticationAccountId, deviceFingerprint], map: "uk_trusted_devices_account_fingerprint")
  @@index([authenticationAccountId], map: "idx_trusted_devices_account_id")
  @@map("trusted_devices")
}

// ---------------------------------------------------------------------------
// Models — Authentication: password_reset_tokens (§3.5, §4.5)
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id                     String    @id @default(uuid()) @db.Uuid @map("id")
  authenticationAccountId String   @db.Uuid @map("authentication_account_id")
  token                  String    @unique @db.VarChar(500) @map("token")
  expiresAt              DateTime  @map("expires_at")
  usedAt                 DateTime? @map("used_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id], onDelete: Cascade)

  @@index([authenticationAccountId], map: "idx_password_reset_account_id")
  @@index([token], map: "idx_password_reset_token")
  @@index([expiresAt], map: "idx_password_reset_expires_at")
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Models — Authentication: password_history (§3.6, §4.6)
// ---------------------------------------------------------------------------

model PasswordHistory {
  id                     String   @id @default(uuid()) @db.Uuid @map("id")
  authenticationAccountId String  @db.Uuid @map("authentication_account_id")
  passwordHash           String   @db.VarChar(255) @map("password_hash")
  createdAt              DateTime @default(now()) @map("created_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id], onDelete: Cascade)

  @@index([authenticationAccountId, createdAt], map: "idx_password_history_account_created")
  @@map("password_history")
}

// ---------------------------------------------------------------------------
// Models — Authentication: authentication_methods (§3.7, §4.7)
// ---------------------------------------------------------------------------

model AuthenticationMethod {
  id                     String                  @id @default(uuid()) @db.Uuid @map("id")
  authenticationAccountId String                  @db.Uuid @map("authentication_account_id")
  providerType           AuthenticationProviderType @map("provider_type")
  providerIdentifier     String                  @db.VarChar(255) @map("provider_identifier")
  externalSubjectId      String                  @db.VarChar(255) @map("external_subject_id")
  connectionMetadata     Json?                   @db.Json @map("connection_metadata")
  connectedAt            DateTime                @map("connected_at")
  lastVerifiedAt         DateTime?               @map("last_verified_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  authenticationAccount AuthenticationAccount @relation(fields: [authenticationAccountId], references: [id], onDelete: Cascade)

  @@unique([authenticationAccountId, providerType, externalSubjectId], map: "uk_auth_methods_account_provider_subject")
  @@index([authenticationAccountId], map: "idx_auth_methods_account_id")
  @@map("authentication_methods")
}

// ---------------------------------------------------------------------------
// Models — Authorization: roles (§3.8, §4.8)
// ---------------------------------------------------------------------------

model Role {
  id                String    @id @default(uuid()) @db.Uuid @map("id")
  institutionId     String?   @db.Uuid @map("institution_id")
  name              String    @db.VarChar(100) @map("name")
  description       String?   @db.VarChar(500) @map("description")
  type              RoleType  @default(CUSTOM) @map("type")
  workspaceConfig   Json?     @db.Json @map("workspace_config")
  moduleAccess      Json?     @db.Json @map("module_access")
  approvalAuthority Json?     @db.Json @map("approval_authority")
  isDefault         Boolean   @default(false) @map("is_default")
  isDeletable       Boolean   @default(true) @map("is_deletable")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@unique([institutionId, name], map: "uk_roles_institution_name")
  @@index([institutionId, type], map: "idx_roles_institution_type")
  @@index([isDefault], map: "idx_roles_is_default")
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Models — Authorization: permissions (§3.9, §4.9)
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid()) @db.Uuid @map("id")
  identifier  String   @unique @db.VarChar(100) @map("identifier")
  module      String   @db.VarChar(50) @map("module")
  resource    String   @db.VarChar(50) @map("resource")
  action      String   @db.VarChar(50) @map("action")
  description String?  @db.VarChar(500) @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions             RolePermission[]
  userPermissions             UserPermission[]
  permissionGroupPermissions PermissionGroupPermission[]

  @@index([module, resource, action], map: "idx_permissions_module_resource_action")
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Models — Authorization: permission_groups (§3.10, §4.10)
// ---------------------------------------------------------------------------

model PermissionGroup {
  id            String    @id @default(uuid()) @db.Uuid @map("id")
  institutionId String    @db.Uuid @map("institution_id")
  name          String    @db.VarChar(100) @map("name")
  description   String?   @db.VarChar(500) @map("description")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  permissionGroupPermissions PermissionGroupPermission[]

  @@unique([institutionId, name], map: "uk_permission_groups_institution_name")
  @@index([institutionId], map: "idx_permission_groups_institution_id")
  @@map("permission_groups")
}

// ---------------------------------------------------------------------------
// Models — Authorization: role_assignments (§3.11, §4.11)
// ---------------------------------------------------------------------------

model RoleAssignment {
  id          String               @id @default(uuid()) @db.Uuid @map("id")
  userId      String               @db.Uuid @map("user_id")
  roleId      String               @db.Uuid @map("role_id")
  assignedBy  String               @db.Uuid @map("assigned_by")
  assignedAt  DateTime             @default(now()) @map("assigned_at")
  expiresAt   DateTime?            @map("expires_at")
  scope       String?              @db.VarChar(500) @map("scope")
  reason      String?              @db.VarChar(500) @map("reason")
  source      RoleAssignmentSource? @map("source")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignor User @relation("RoleAssignmentAssignor", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@unique([userId, roleId], map: "uk_role_assignments_user_role")
  @@index([userId], map: "idx_role_assignments_user_id")
  @@index([roleId], map: "idx_role_assignments_role_id")
  @@index([assignedBy], map: "idx_role_assignments_assigned_by")
  @@map("role_assignments")
}

// ---------------------------------------------------------------------------
// Models — Authorization: role_permissions (§3.12, §4.12)
// ---------------------------------------------------------------------------

model RolePermission {
  id                String               @id @default(uuid()) @db.Uuid @map("id")
  roleId            String               @db.Uuid @map("role_id")
  permissionId      String               @db.Uuid @map("permission_id")
  addedBy           String               @db.Uuid @map("added_by")
  addedAt           DateTime             @default(now()) @map("added_at")
  source            RolePermissionSource? @map("source")
  permissionGroupId String?              @db.Uuid @map("permission_group_id")
  createdAt         DateTime             @default(now()) @map("created_at")

  role            Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  adder           User             @relation("RolePermissionAdder", fields: [addedBy], references: [id], onDelete: Restrict)
  permissionGroup PermissionGroup? @relation(fields: [permissionGroupId], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId], map: "uk_role_permissions_role_permission")
  @@index([roleId], map: "idx_role_permissions_role_id")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@index([addedBy], map: "idx_role_permissions_added_by")
  @@index([permissionGroupId], map: "idx_role_permissions_permission_group_id")
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Models — Authorization: user_permissions (§3.13, §4.13)
// ---------------------------------------------------------------------------

model UserPermission {
  id           String           @id @default(uuid()) @db.Uuid @map("id")
  userId       String           @db.Uuid @map("user_id")
  permissionId String           @db.Uuid @map("permission_id")
  grantedBy    String           @db.Uuid @map("granted_by")
  grantedAt    DateTime         @default(now()) @map("granted_at")
  reason       String?          @db.VarChar(500) @map("reason")
  expiresAt    DateTime?        @map("expires_at")
  scope        String?          @db.VarChar(500) @map("scope")
  effect       PermissionEffect @default(ALLOW) @map("effect")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  granter    User       @relation("UserPermissionGranter", fields: [grantedBy], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId], map: "uk_user_permissions_user_permission")
  @@index([userId], map: "idx_user_permissions_user_id")
  @@index([permissionId], map: "idx_user_permissions_permission_id")
  @@index([grantedBy], map: "idx_user_permissions_granted_by")
  @@map("user_permissions")
}

// ---------------------------------------------------------------------------
// Models — Authorization: permission_group_permissions (§3.14, §4.14)
// ---------------------------------------------------------------------------

model PermissionGroupPermission {
  id                String   @id @default(uuid()) @db.Uuid @map("id")
  permissionGroupId String   @db.Uuid @map("permission_group_id")
  permissionId      String   @db.Uuid @map("permission_id")
  createdAt         DateTime @default(now()) @map("created_at")

  permissionGroup PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  permission      Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([permissionGroupId, permissionId], map: "uk_pgp_group_permission")
  @@index([permissionGroupId], map: "idx_pgp_permission_group_id")
  @@index([permissionId], map: "idx_pgp_permission_id")
  @@map("permission_group_permissions")
}

// ---------------------------------------------------------------------------
// Models — Sessions: sessions (§3.15, §4.15)
// ---------------------------------------------------------------------------

model Session {
  id                String                  @id @default(uuid()) @db.Uuid @map("id")
  userId            String                  @db.Uuid @map("user_id")
  token             String                  @unique @db.VarChar(500) @map("token")
  deviceFingerprint String?                 @db.VarChar(500) @map("device_fingerprint")
  ipAddress         String                  @db.VarChar(45) @map("ip_address")
  userAgent         String?                 @db.VarChar(500) @map("user_agent")
  authMethod        String?                 @db.VarChar(50) @map("auth_method")
  lastActiveAt      DateTime                @map("last_active_at")
  expiresAt         DateTime                @map("expires_at")
  terminatedAt      DateTime?               @map("terminated_at")
  terminatedBy      String?                 @db.Uuid @map("terminated_by")
  terminatedReason  SessionTerminationReason? @map("terminated_reason")
  createdAt         DateTime                @default(now()) @map("created_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  terminator User? @relation("SessionTerminator", fields: [terminatedBy], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt], map: "idx_sessions_user_expires")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([terminatedBy], map: "idx_sessions_terminated_by")
  @@index([token], map: "idx_sessions_token")
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Models — Delegation: delegations (§3.16, §4.16)
// ---------------------------------------------------------------------------

model Delegation {
  id             String           @id @default(uuid()) @db.Uuid @map("id")
  institutionId  String           @db.Uuid @map("institution_id")
  grantorId      String           @db.Uuid @map("grantor_id")
  delegateId     String           @db.Uuid @map("delegate_id")
  scope          Json             @db.Json @map("scope")
  reason         String?          @db.VarChar(500) @map("reason")
  startsAt       DateTime         @map("starts_at")
  expiresAt      DateTime         @map("expires_at")
  status         DelegationStatus @default(PENDING) @map("status")
  approvedBy     String?          @db.Uuid @map("approved_by")
  approvedAt     DateTime?        @map("approved_at")
  revokedAt      DateTime?        @map("revoked_at")
  revokedBy      String?          @db.Uuid @map("revoked_by")
  revokedReason  String?          @db.VarChar(500) @map("revoked_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  grantor  User  @relation("DelegationGrantor", fields: [grantorId], references: [id], onDelete: Restrict)
  delegate User  @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Restrict)
  approver User? @relation("DelegationApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  revoker  User? @relation("DelegationRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([institutionId, status], map: "idx_delegations_institution_status")
  @@index([grantorId], map: "idx_delegations_grantor_id")
  @@index([delegateId], map: "idx_delegations_delegate_id")
  @@index([approvedBy], map: "idx_delegations_approved_by")
  @@index([revokedBy], map: "idx_delegations_revoked_by")
  @@index([expiresAt], map: "idx_delegations_expires_at")
  @@map("delegations")
}

// ---------------------------------------------------------------------------
// Models — Invitation: invitations (§3.17, §4.17)
// ---------------------------------------------------------------------------

model Invitation {
  id            String           @id @default(uuid()) @db.Uuid @map("id")
  institutionId String           @db.Uuid @map("institution_id")
  email         String           @db.VarChar(255) @map("email")
  token         String           @unique @db.VarChar(500) @map("token")
  status        InvitationStatus @default(CREATED) @map("status")
  sentAt        DateTime?        @map("sent_at")
  expiresAt     DateTime         @map("expires_at")
  acceptedAt    DateTime?        @map("accepted_at")
  invitedBy     String           @db.Uuid @map("invited_by")
  userId        String?          @db.Uuid @map("user_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  inviter User  @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  user    User? @relation("InvitationUser", fields: [userId], references: [id], onDelete: SetNull)
  invitationRoles InvitationRole[]

  @@index([institutionId, email, status], map: "idx_invitations_institution_email_status")
  @@index([invitedBy], map: "idx_invitations_invited_by")
  @@index([userId], map: "idx_invitations_user_id")
  @@index([expiresAt], map: "idx_invitations_expires_at")
  @@index([token], map: "idx_invitations_token")
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Models — Invitation: invitation_roles (§3.18, §4.18)
// ---------------------------------------------------------------------------

model InvitationRole {
  id            String   @id @default(uuid()) @db.Uuid @map("id")
  invitationId  String   @db.Uuid @map("invitation_id")
  roleId        String   @db.Uuid @map("role_id")
  createdAt     DateTime @default(now()) @map("created_at")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([invitationId, roleId], map: "uk_invitation_roles_invitation_role")
  @@index([invitationId], map: "idx_invitation_roles_invitation_id")
  @@index([roleId], map: "idx_invitation_roles_role_id")
  @@map("invitation_roles")
}

// ---------------------------------------------------------------------------
// Models — Security Monitoring: authentication_events (§3.19, §4.19)
// ---------------------------------------------------------------------------

model AuthenticationEvent {
  id            String               @id @default(uuid()) @db.Uuid @map("id")
  userId        String               @db.Uuid @map("user_id")
  eventType     AuthenticationEventType @map("event_type")
  ipAddress     String               @db.VarChar(45) @map("ip_address")
  device        String?              @db.VarChar(500) @map("device")
  metadata      Json?                @db.Json @map("metadata")
  createdAt     DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, eventType, createdAt], map: "idx_auth_events_user_type_created")
  @@index([eventType, createdAt], map: "idx_auth_events_type_created")
  @@index([userId], map: "idx_auth_events_user_id")
  @@map("authentication_events")
}
