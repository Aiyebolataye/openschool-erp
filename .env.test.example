# OpenSchool API — Test environment template
# Copy to apps/api/.env.test before running integration/e2e tests.
# All fields are required unless marked optional.

NODE_ENV=test
PORT=3001
API_PREFIX=api/v1

DATABASE_URL=postgresql://openschool:openschool@localhost:5433/openschool_test?schema=public

JWT_SECRET=test-secret-at-least-32-characters-long-ok
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=         # optional

# S3 / MinIO (optional — tests that don't touch documents can skip)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=openschool-test
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Payment stubs (optional — finance tests stub the Paystack client)
# PAYSTACK_SECRET_KEY=test-paystack-secret
# PAYSTACK_WEBHOOK_SECRET=test-webhook-secret

# Throttle (pre-auth login throttling + tenant ceiling; consumed by guards)
THROTTLE_TTL=1000
THROTTLE_LIMIT=100
THROTTLE_IDENTIFIER_LIMIT=20

# Login protection (D-09 / P-16: max 5 recent failures, 3-10)
LOGIN_MAX_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Sessions (B4 / P1.4)
SESSION_MAX_SESSIONS=5
SESSION_CLEANUP_INTERVAL_MINUTES=60