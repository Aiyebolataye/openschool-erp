# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://openschool:openschool@localhost:5433/openschool_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=openschool-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Payment (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# SMS
SMS_PROVIDER=
SMS_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3001