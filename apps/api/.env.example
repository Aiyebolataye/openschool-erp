# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://openschool:openschool@localhost:5433/openschool_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Identity — registration & invitations
# Comma-separated roles permitted for public (non-invite) registration. Default empty = invitation-only.
AUTH_PUBLIC_REGISTRATION_ROLES=
INVITATION_EXPIRY_DAYS=7
INVITATION_MAX_PENDING=50
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
ONBOARDING_LINK_EXPIRY_DAYS=182
DELIVERY_PROVIDER=dev

# S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=openschool-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Payment (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# SMS
SMS_PROVIDER=
SMS_API_KEY=

# CORS
# Comma-separated list of allowed browser origins (frozen B1 remainder — CORS gate).
# Production default is none; '*' is rejected in production by validateEnv.
CORS_ORIGINS=http://localhost:3001

# HTTP / security gate (frozen B1 remainder)
BODY_LIMIT=1mb
HSTS_MAX_AGE_SECONDS=15552000
HSTS_INCLUDE_SUBDOMAINS=true
# Swagger gate (P1.6): enabled outside production unless SWAGGER_ENABLED=true/false is set.
SWAGGER_ENABLED=
# Audit (P1.7): persist canonical actor email in audit_logs.actor_email (default true).
AUDIT_ACTOR_EMAIL_CAPTURE=true