model FeeStructure {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  institutionId   String   @db.Uuid
  academicYearId  String   @db.Uuid
  termId          String?  @db.Uuid
  name            String
  description     String?
  category        String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("NGN")
  isMandatory     Boolean  @default(true)
  status          UserRoleStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  institution     Institution  @relation(fields: [institutionId], references: [id])
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  term            Term?        @relation(fields: [termId], references: [id])
  invoices        Invoice[]

  @@unique([tenantId, name, academicYearId])
  @@index([tenantId, institutionId])
  @@map("fee_structures")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  studentId       String        @db.Uuid
  feeStructureId  String        @db.Uuid
  academicYearId  String        @db.Uuid
  termId          String?       @db.Uuid
  invoiceNumber   String
  description     String?
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  balance         Decimal       @default(0) @db.Decimal(10, 2)
  status          InvoiceStatus @default(PENDING)
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  student         Student       @relation(fields: [studentId], references: [id])
  feeStructure    FeeStructure  @relation(fields: [feeStructureId], references: [id])
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id])
  term            Term?         @relation(fields: [termId], references: [id])
  payments        Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("invoices")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  invoiceId       String        @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("NGN")
  method          PaymentMethod @default(BANK_TRANSFER)
  reference       String        @unique
  externalRef     String?
  status          PaymentStatus @default(PENDING)
  verifiedAt      DateTime?
  notes           String?
  receiptUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  invoice         Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, invoiceId])
  @@index([reference])
  @@map("payments")
}

model Scholarship {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String
  description     String?
  type            String
  amount          Decimal  @db.Decimal(10, 2)
  percentage      Decimal? @db.Decimal(5, 2)
  criteria        String?
  academicYearId  String?  @db.Uuid
  status          UserRoleStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("scholarships")
}

model Refund {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  paymentId       String        @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  reason          String
  status          PaymentStatus @default(PENDING)
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([tenantId, paymentId])
  @@map("refunds")
}
