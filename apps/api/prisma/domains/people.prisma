// ============================================================================
// People domain (PEOPLE-1 — People Foundation, Master Roadmap Phase 4)
//
// Authoritative design source: engineering/People Engineering.md §7 (frozen)
// with the §18-approved architecture decisions:
//   • Person is the root identity aggregate; role sub-types (Student, Staff,
//     Parent, Guardian, Applicant) reference people and add role-specific
//     attributes. Identity attributes live ONLY on people (single source of
//     truth; no denormalized first/last name or gender on sub-types).
//   • Person ↔ User link (approved §18 #3): nullable `userId` bridge on the
//     rebuilt Student/Staff/Parent/Guardian records. `User.personId` is NOT
//     added. Phase-1/2 identity/session architecture remains authoritative.
//   • `publicId` is server-generated, immutable, unique per tenant
//     (P-/STU-/EMP-/APP-YYYY-NNNNNN). Generation foundation: people.utils.
//   • Explicit lifecycle/status enums per table (approved §18 #2).
//   • `internalEmail` and `studentNumber`/`staffNumber` Prisma field names are
//     retained on Student/Staff (mapped to spec columns) because Phase-1 login
//     resolution (auth.service.resolveIdentity) and the identity-b1 e2e suite
//     depend on them. Additive columns, documented in the implementation report.
//   • student_enrollment_details.academic_session_id and
//     student_academic_records.academic_session_id are nullable UUID columns
//     (spec People Engineering §7.2 FK → academic_sessions). Academic Session
//     ownership lives in the Academics domain (frozen-spec deviation D2);
//     PHASE 5 wires the deferred FK relation to the authoritative
//     AcademicSession model (see Migration report §legacy→new mapping).
// ============================================================================

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ENROLLED
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum StaffStatus {
  HIRED
  ACTIVE
  ON_LEAVE
  SEPARATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum ContactPreference {
  EMAIL
  PHONE
  SMS
  WHATSAPP
}

enum ParentStatus {
  ACTIVE
  INACTIVE
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum ApplicantStatus {
  APPLIED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ApplicantSource {
  WEBSITE
  REFERRAL
  WALK_IN
  AGENT
  OTHER
}

enum RelationshipType {
  PARENT
  GUARDIAN
  SIBLING
  EMERGENCY_CONTACT
  AUTHORIZED_PICKUP
  STAFF_STUDENT
  OTHER
}

enum DocumentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RoleContext {
  STUDENT
  STAFF
  PARENT
  GUARDIAN
  APPLICANT
}

model Person {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  publicId        String         @map("public_id") @db.VarChar(20)
  firstName       String         @map("first_name") @db.VarChar(100)
  lastName        String         @map("last_name") @db.VarChar(100)
  middleName      String?        @map("middle_name") @db.VarChar(100)
  email           String         @db.VarChar(255)
  phone           String?        @db.VarChar(50)
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  gender          Gender
  bloodGroup      String?        @map("blood_group") @db.VarChar(10)
  stateOfOrigin   String?        @map("state_of_origin") @db.VarChar(100)
  address         String?        @db.VarChar(500)
  status          PersonStatus   @default(ACTIVE)
  isActive        Boolean        @default(true) @map("is_active")
  profilePhotoRef String?        @map("profile_photo_ref") @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at")
  createdBy       String?        @map("created_by") @db.Uuid
  updatedAt       DateTime       @updatedAt @map("updated_at")
  updatedBy       String?        @map("updated_by") @db.Uuid
  deletedAt       DateTime?      @map("deleted_at")
  deletedBy       String?        @map("deleted_by") @db.Uuid
  version         Int            @default(1)

  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  profile            PersonProfile?
  personInstitutions PersonInstitution[]
  students           Student[]
  staff              Staff[]
  parents            Parent[]
  guardians          Guardian[]
  applicants         Applicant[]
  emergencyContacts  EmergencyContact[]
  sourceRelationships PersonRelationship[]   @relation("person_relations_source")
  targetRelationships PersonRelationship[]   @relation("person_relations_target")
  documents          PeopleDocument[]

  @@unique([tenantId, email])
  @@unique([tenantId, publicId])
  @@index([tenantId, status])
  @@index([tenantId, isActive])
  @@index([tenantId, firstName, lastName])
  @@map("people")
}

model PersonProfile {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  personId     String   @unique @db.Uuid
  bio          String?  @db.VarChar(1000)
  customFields Json?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?  @map("deleted_by") @db.Uuid
  version      Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@index([tenantId])
  @@map("person_profiles")
}

model PersonInstitution {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  personId      String       @db.Uuid
  institutionId String       @db.Uuid
  roleContext   RoleContext  @map("role_context")
  assignedAt    DateTime     @default(now()) @map("assigned_at")
  assignedBy    String?      @map("assigned_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")
  updatedBy     String?      @map("updated_by") @db.Uuid
  deletedAt     DateTime?    @map("deleted_at")
  deletedBy     String?      @map("deleted_by") @db.Uuid
  version       Int          @default(1)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  person      Person      @relation(fields: [personId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, personId, institutionId, roleContext])
  @@index([tenantId, personId])
  @@index([tenantId, institutionId])
  @@map("person_institutions")
}

model Student {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  personId        String        @db.Uuid
  institutionId   String        @db.Uuid
  userId          String?       @unique @db.Uuid
  publicId        String        @map("public_id") @db.VarChar(20)
  internalEmail   String?       @map("internal_email") @db.VarChar(255)
  studentNumber   String?       @map("student_id_number") @db.VarChar(50)
  enrollmentDate  DateTime      @default(now()) @map("enrollment_date") @db.Date
  status          StudentStatus @default(ENROLLED)
  createdAt       DateTime      @default(now()) @map("created_at")
  createdBy       String?       @map("created_by") @db.Uuid
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedBy       String?       @map("updated_by") @db.Uuid
  deletedAt       DateTime?     @map("deleted_at")
  deletedBy       String?       @map("deleted_by") @db.Uuid
  version         Int           @default(1)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  institution     Institution             @relation(fields: [institutionId], references: [id])
  person          Person                  @relation(fields: [personId], references: [id])
  user            User?                   @relation(fields: [userId], references: [id])
  enrollmentDetail StudentEnrollmentDetail?
  academicRecords StudentAcademicRecord[]
  graduationDetail StudentGraduationDetail?
  transferDetail  StudentTransferDetail?
  withdrawalDetail StudentWithdrawalDetail?
  invoices        Invoice[]
  documents       Document[]
  libraryLoans    BookLoan[]
  hostelAllocations HostelAllocation[]
  transportAllocations TransportAllocation[]

  @@unique([tenantId, personId, institutionId])
  @@unique([tenantId, publicId])
  @@unique([tenantId, institutionId, studentNumber])
  @@unique([tenantId, institutionId, internalEmail])
  @@index([tenantId, personId])
  @@index([tenantId, institutionId])
  @@index([tenantId, status])
  @@map("students")
}

model StudentEnrollmentDetail {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  studentId         String   @unique @db.Uuid
  academicSessionId String?  @map("academic_session_id") @db.Uuid
  gradeLevel        String   @map("grade_level") @db.VarChar(50)
  className         String?  @map("class_name") @db.VarChar(50)
  stream            String?  @db.VarChar(50)
  enrollmentType    String   @map("enrollment_type") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")
  updatedBy         String?  @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?  @map("deleted_by") @db.Uuid
  version           Int      @default(1)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  academicSession AcademicSession? @relation("PeopleEnrollmentAcademicSession", fields: [academicSessionId], references: [id])

  @@map("student_enrollment_details")
}

