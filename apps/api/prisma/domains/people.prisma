model Staff {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  personId        String         @db.Uuid
  institutionId   String         @db.Uuid
  userId          String?        @unique @db.Uuid
  publicId        String         @map("public_id") @db.VarChar(20)
  internalEmail   String?        @map("internal_email") @db.VarChar(255)
  staffNumber     String?        @map("employee_id") @db.VarChar(50)
  hireDate        DateTime       @default(now()) @map("hire_date") @db.Date
  employmentType  EmploymentType @default(FULL_TIME) @map("employment_type")
  status          StaffStatus    @default(HIRED)
  createdAt       DateTime       @default(now()) @map("created_at")
  createdBy       String?        @map("created_by") @db.Uuid
  updatedAt       DateTime       @updatedAt @map("updated_at")
  updatedBy       String?        @map("updated_by") @db.Uuid
  deletedAt       DateTime?      @map("deleted_at")
  deletedBy       String?        @map("deleted_by") @db.Uuid
  version         Int            @default(1)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  institution      Institution       @relation(fields: [institutionId], references: [id])
  person           Person            @relation(fields: [personId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  employmentDetail StaffEmploymentDetail?
  qualifications   StaffQualification[]
  certifications   StaffCertification[]
  employmentHistory StaffEmploymentHistory[]
  maintenanceRequests MaintenanceRequest[]
  leaveRequests    LeaveRequest[]
  subordinates     StaffEmploymentDetail[] @relation("ReportingStaff")

  @@unique([tenantId, personId, institutionId])
  @@unique([tenantId, publicId])
  @@unique([tenantId, institutionId, staffNumber])
  @@unique([tenantId, institutionId, internalEmail])
  @@index([tenantId, personId])
  @@index([tenantId, institutionId])
  @@index([tenantId, status])
  @@map("staff")
}

