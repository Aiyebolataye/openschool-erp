model Tenant {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  subdomain     String?       @unique
  logoUrl       String?
  primaryColor  String?       @default("#2563EB")
  subscription  String        @default("free")
  status        UserRoleStatus @default(ACTIVE)
  maxStudents   Int           @default(500)
  maxStaff      Int           @default(100)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  institutions           Institution[]
  institutionConfigurations InstitutionConfiguration[]
  institutionSettings     InstitutionSetting[]
  users           User[]
  featureFlags    FeatureFlag[]
  auditLogs      AuditLog[]
  userInvitations UserInvitation[]
  passwordPolicies PasswordPolicy[]
  organizationMemberships OrganizationMembership[]
  institutionMemberships  InstitutionMembership[]
  onboardingLinks         OnboardingLink[]
  loginAttempts           LoginAttempt[]
  sessions                Session[]
  userRoleAssignments     UserRoleAssignment[]

  people               Person[]
  personProfiles       PersonProfile[]
  personInstitutions   PersonInstitution[]
  students             Student[]
  studentEnrollmentDetails StudentEnrollmentDetail[]
  studentAcademicRecords   StudentAcademicRecord[]
  studentGraduationDetails StudentGraduationDetail[]
  studentTransferDetails   StudentTransferDetail[]
  studentWithdrawalDetails StudentWithdrawalDetail[]
  staff                Staff[]
  staffEmploymentDetails  StaffEmploymentDetail[]
  staffQualifications     StaffQualification[]
  staffCertifications     StaffCertification[]
  staffEmploymentHistory  StaffEmploymentHistory[]
  parents              Parent[]
  guardians            Guardian[]
  applicants           Applicant[]
  emergencyContacts    EmergencyContact[]
  personRelationships  PersonRelationship[]
  peopleDocuments      PeopleDocument[]

  @@index([slug])
  @@map("tenants")
}

model Institution {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  name            String
  code            String
  status          InstitutionStatus @default(ACTIVE)
  logoUrl         String?
  address         String?
  city            String?
  state           String?
  country         String   @default("NG")
  phone           String?
  email           String?
  website         String?
  motto           String?
  timezone        String   @default("Africa/Lagos")
  currency        String   @default("NGN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  departments     Department[]
  academicYears   AcademicYear[]
  academicSessions AcademicSession[]
  terms           Term[]
  subjects        Subject[]
  subjectGroups   SubjectGroup[]
  streams         Stream[]
  gradeLevels     GradeLevel[]
  classes         Class[]
  timetables      Timetable[]
  gradeScales     GradeScale[]
  academicPolicies AcademicPolicy[]
  summerSchoolSessions SummerSchoolSession[]
  students        Student[]
  staff           Staff[]
  feeStructures   FeeStructure[]
  feeCategories   FeeCategory[]
  feeItems        FeeItem[]
  feeTemplates    FeeTemplate[]
  feeSchedules    FeeSchedule[]
  feeScheduleItems FeeScheduleItem[]
  bills           Bill[]
  discounts       Discount[]
  ledgerAccounts  LedgerAccount[]
  financialPeriods FinancialPeriod[]
  journalEntries  JournalEntry[]
  journalEntryLines JournalEntryLine[]
  accountBalances AccountBalance[]
  financialPolicies FinancialPolicy[]
  transportRoutes TransportRoute[]
  hostels         Hostel[]
  institutionConfigurations InstitutionConfiguration[]
  institutionSettings       InstitutionSetting[]
  memberships     InstitutionMembership[]
  onboardingLinks OnboardingLink[]
  personInstitutions PersonInstitution[]
  parents            Parent[]
  guardians          Guardian[]
  applicants         Applicant[]
  studentTransferSources     StudentTransferDetail[] @relation("TransferSourceInstitution")
  studentTransferDestinations StudentTransferDetail[] @relation("TransferDestinationInstitution")
  personRelationships        PersonRelationship[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("institutions")
}
