// ============================================================================
// Academic domain (PHASE 5 — Academic Management, Master Roadmap P5.1-P5.8)
//
// Authoritative design source: engineering/Academic Management Engineering.md
// §7 (table catalogue / column catalogue / constraints / indexes), §8
// (Prisma schema, enums) — frozen v1.2. Governed by locked decisions D-1..D-4:
//   • D-1: replaces the legacy academic structures (academic_years, terms,
//     curricula, subjects, classes, enrollments, grades, results + operations
//     attendance + documents assignments/submissions + institution
//     departments). Legacy tables are archived to `_academic_legacy_*` by the
//     archive migration (data preserved); this file is the authoritative
//     model set. See docs/PHASE_5_MIGRATION_REPORT.md.
//   • D-3: the Academic domain is the canonical owner of Year / Session /
//     Term / Department / AcademicPolicy and calendar semantics. The
//     Institution spec's academic_sessions/academic_terms/academic_holidays
//     catalogue is NOT materialized here or in the institution domain.
//   • Cross-domain references to the People domain (student_person_id,
//     staff_person_id, head_staff_id) are plain UUID columns WITHOUT Prisma
//     relations per the frozen §8 cross-domain reference decision (the People
//     Student/Staff aggregates own their PKs; FKs are enforced at the
//     application layer by the academics module).
//   • D-4 events / dedup are additive work in the event envelope (see
//     src/modules/events) and are not represented in these tables.
//
// Attendance "check exactly one of student_class_enrollment_id /
// staff_person_id" and the partial unique (attendance_type = STUDENT) are
// enforced by the Postgres NULL-DISTINCT partial-index semantics of
// @@unique([tenantId, studentClassEnrollmentId, subjectId, date]) plus a
// CHECK constraint created by the archive migration (migration SQL).
// ============================================================================

// ---------------------------------------------------------------------------
// Academic calendar core
// ---------------------------------------------------------------------------

model AcademicYear {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  institutionId String             @db.Uuid
  name          String             @db.VarChar(50)
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  status        AcademicYearStatus @default(DRAFT)
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  createdBy     String?            @map("created_by") @db.Uuid
  updatedAt     DateTime           @updatedAt @map("updated_at")
  updatedBy     String?            @map("updated_by") @db.Uuid
  deletedAt     DateTime?          @map("deleted_at")
  deletedBy     String?            @map("deleted_by") @db.Uuid
  version       Int                @default(1)

  sessions   AcademicSession[]
  feeStructures FeeStructure[]
  invoices   Invoice[]

  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, name])
  @@index([tenantId, institutionId], name: "idx_ay_tenant_institution")
  @@index([tenantId, status], name: "idx_ay_status")
  @@map("academic_years")
}

model AcademicSession {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  institutionId String       @db.Uuid
  academicYearId String      @db.Uuid
  name          String       @db.VarChar(50)
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date
  status        SessionStatus @default(DRAFT)
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")
  updatedBy     String?      @map("updated_by") @db.Uuid
  deletedAt     DateTime?    @map("deleted_at")
  deletedBy     String?      @map("deleted_by") @db.Uuid
  version       Int          @default(1)

  year  AcademicYear @relation(fields: [academicYearId], references: [id])
  terms Term[]
  institution Institution @relation(fields: [institutionId], references: [id])
  studentEnrollmentDetails StudentEnrollmentDetail[] @relation("PeopleEnrollmentAcademicSession")
  studentAcademicRecords   StudentAcademicRecord[]   @relation("PeopleRecordAcademicSession")

  @@unique([tenantId, institutionId, academicYearId, name])
  @@index([tenantId, academicYearId], name: "idx_as_tenant_year")
  @@map("academic_sessions")
}

model Term {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  institutionId String   @db.Uuid
  academicSessionId String @db.Uuid
  name          String   @db.VarChar(50)
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  status        TermStatus @default(DRAFT)
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?  @map("deleted_by") @db.Uuid
  version       Int      @default(1)

  session AcademicSession @relation(fields: [academicSessionId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  teachingAssignments TeachingAssignment[]
  timetables          Timetable[]
  studentClassEnrollments StudentClassEnrollment[]
  assignments         Assignment[]
  assessments         Assessment[]
  results             Result[]
  reportCards         ReportCard[]
  academicProgressions AcademicProgression[]
  summerSchoolSessions SummerSchoolSession[]

  feeStructures FeeStructure[]
  invoices      Invoice[]
  libraryLoans  BookLoan[]
  maintenanceRequests MaintenanceRequest[]
  leaveRequests LeaveRequest[]

  @@unique([tenantId, institutionId, academicSessionId, name])
  @@index([tenantId, academicSessionId], name: "idx_terms_tenant_session")
  @@map("terms")
}

// ---------------------------------------------------------------------------
// Curriculum: subject, subject group, department, stream
// ---------------------------------------------------------------------------

model Subject {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  institutionId String        @db.Uuid
  departmentId  String?       @db.Uuid
  name          String        @db.VarChar(100)
  code          String        @db.VarChar(20)
  description   String?       @db.VarChar(500)
  status        SubjectStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  createdBy     String?       @map("created_by") @db.Uuid
  updatedAt     DateTime      @updatedAt @map("updated_at")
  updatedBy     String?       @map("updated_by") @db.Uuid
  deletedAt     DateTime?     @map("deleted_at")
  deletedBy     String?       @map("deleted_by") @db.Uuid
  version       Int           @default(1)

  department Department? @relation(fields: [departmentId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  subjectGroups     SubjectSubjectGroup[]
  teachingAssignments TeachingAssignment[]
  timetableSlots     TimetableSlot[]
  subjectRegistrations SubjectRegistration[]
  attendance         Attendance[]
  assignments        Assignment[]
  assessments        Assessment[]
  results            Result[]
  summerSchoolResults SummerSchoolResult[]

  @@unique([tenantId, institutionId, code])
  @@index([tenantId, institutionId], name: "idx_subjects_tenant_institution")
  @@index([departmentId], name: "idx_subjects_department")
  @@index([tenantId, status], name: "idx_subjects_status")
  @@map("subjects")
}

model SubjectGroup {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  institutionId String       @db.Uuid
  name          String       @db.VarChar(100)
  description   String?      @db.VarChar(500)
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")
  updatedBy     String?      @map("updated_by") @db.Uuid
  deletedAt     DateTime?    @map("deleted_at")
  deletedBy     String?      @map("deleted_by") @db.Uuid
  version       Int          @default(1)

  subjects SubjectSubjectGroup[]
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, name])
  @@map("subject_groups")
}

model SubjectSubjectGroup {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  subjectId      String       @db.Uuid
  subjectGroupId String       @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  subject Subject      @relation(fields: [subjectId], references: [id])
  group   SubjectGroup @relation(fields: [subjectGroupId], references: [id])

  @@unique([tenantId, subjectId, subjectGroupId])
  @@map("subject_subject_groups")
}

model Department {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  institutionId String           @db.Uuid
  name          String           @db.VarChar(100)
  headStaffId   String?          @map("head_staff_id") @db.Uuid
  status        DepartmentStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @updatedAt @map("updated_at")
  updatedBy     String?          @map("updated_by") @db.Uuid
  deletedAt     DateTime?        @map("deleted_at")
  deletedBy     String?          @map("deleted_by") @db.Uuid
  version       Int              @default(1)

  subjects Subject[]
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, name])
  @@index([tenantId, institutionId], name: "idx_departments_tenant")
  @@map("departments")
}

model Stream {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  institutionId String           @db.Uuid
  gradeLevelId  String           @db.Uuid
  name          String           @db.VarChar(100)
  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @updatedAt @map("updated_at")
  updatedBy     String?          @map("updated_by") @db.Uuid
  deletedAt     DateTime?        @map("deleted_at")
  deletedBy     String?          @map("deleted_by") @db.Uuid
  version       Int              @default(1)

  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  classes    Class[]
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, name, gradeLevelId])
  @@map("streams")
}

model GradeLevel {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  institutionId String           @db.Uuid
  name          String           @db.VarChar(50)
  displayOrder  Int              @map("display_order")
  status        GradeLevelStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @updatedAt @map("updated_at")
  updatedBy     String?          @map("updated_by") @db.Uuid
  deletedAt     DateTime?        @map("deleted_at")
  deletedBy     String?          @map("deleted_by") @db.Uuid
  version       Int              @default(1)

  streams Stream[]
  classes Class[]
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, name])
  @@map("grade_levels")
}

// ---------------------------------------------------------------------------
// Class structure: class, arm, homeroom
// ---------------------------------------------------------------------------

model Class {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  institutionId String      @db.Uuid
  gradeLevelId  String      @db.Uuid
  streamId      String?     @db.Uuid
  name          String      @db.VarChar(50)
  capacity      Int
  status        ClassStatus @default(DRAFT)
  createdAt     DateTime    @default(now()) @map("created_at")
  createdBy     String?     @map("created_by") @db.Uuid
  updatedAt     DateTime    @updatedAt @map("updated_at")
  updatedBy     String?     @map("updated_by") @db.Uuid
  deletedAt     DateTime?   @map("deleted_at")
  deletedBy     String?     @map("deleted_by") @db.Uuid
  version       Int         @default(1)

  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  stream     Stream?    @relation(fields: [streamId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  arms                    Arm[]
  homeroom                Homeroom?
  teachingAssignments     TeachingAssignment[]
  timetables              Timetable[]
  studentClassEnrollments StudentClassEnrollment[]
  assignments             Assignment[]
  libraryBookCopies       LibraryBookCopy[]
  progressionsFrom        AcademicProgression[] @relation("ProgressionFromClass")
  progressionsTo          AcademicProgression[] @relation("ProgressionToClass")

  @@unique([tenantId, institutionId, gradeLevelId, name])
  @@index([tenantId, gradeLevelId], name: "idx_classes_tenant_grade")
  @@index([tenantId, institutionId], name: "idx_classes_tenant_institution")
  @@map("classes")
}

model Arm {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  institutionId String   @db.Uuid
  classId       String   @db.Uuid
  name          String   @db.VarChar(10)
  staffPersonId String?  @map("staff_person_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?  @map("deleted_by") @db.Uuid
  version       Int      @default(1)

  class Class @relation(fields: [classId], references: [id])

  @@unique([tenantId, classId, name])
  @@map("arms")
}

model Homeroom {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  institutionId String   @db.Uuid
  classId       String   @unique @db.Uuid
  staffPersonId String?  @map("staff_person_id") @db.Uuid
  assignedAt    DateTime @default(now()) @map("assigned_at")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?  @map("deleted_by") @db.Uuid
  version       Int      @default(1)

  class Class @relation(fields: [classId], references: [id])

  @@map("homerooms")
}

model TeachingAssignment {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  institutionId String       @db.Uuid
  staffPersonId String       @map("staff_person_id") @db.Uuid
  subjectId     String       @db.Uuid
  classId       String       @db.Uuid
  termId        String       @db.Uuid
  role          TeachingRole
  workloadHours Int?         @map("workload_hours")
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")
  updatedBy     String?      @map("updated_by") @db.Uuid
  deletedAt     DateTime?    @map("deleted_at")
  deletedBy     String?      @map("deleted_by") @db.Uuid
  version       Int          @default(1)

  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([tenantId, staffPersonId, subjectId, classId, termId])
  @@index([staffPersonId], name: "idx_ta_staff")
  @@index([classId], name: "idx_ta_class")
  @@index([subjectId], name: "idx_ta_subject")
  @@index([termId], name: "idx_ta_term")
  @@map("teaching_assignments")
}

// ---------------------------------------------------------------------------
// Timetable
// ---------------------------------------------------------------------------

model Timetable {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  institutionId String           @db.Uuid
  classId       String           @db.Uuid
  termId        String           @db.Uuid
  status        TimetableStatus  @default(DRAFT)
  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @updatedAt @map("updated_at")
  updatedBy     String?          @map("updated_by") @db.Uuid
  deletedAt     DateTime?        @map("deleted_at")
  deletedBy     String?          @map("deleted_by") @db.Uuid
  version       Int              @default(1)

  class Class @relation(fields: [classId], references: [id])
  term  Term   @relation(fields: [termId], references: [id])
  slots TimetableSlot[]
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, classId, termId])
  @@index([classId], name: "idx_tt_class")
  @@index([termId], name: "idx_tt_term")
  @@map("timetables")
}

model TimetableSlot {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  institutionId String     @db.Uuid
  timetableId   String     @db.Uuid
  dayOfWeek     DayOfWeek  @map("day_of_week")
  startTime     DateTime   @map("start_time") @db.Time(0)
  endTime       DateTime   @map("end_time") @db.Time(0)
  subjectId     String     @db.Uuid
  staffPersonId String?    @map("staff_person_id") @db.Uuid
  room          String?    @db.VarChar(100)
  createdAt     DateTime   @default(now()) @map("created_at")
  createdBy     String?    @map("created_by") @db.Uuid
  updatedAt     DateTime   @updatedAt @map("updated_at")
  updatedBy     String?    @map("updated_by") @db.Uuid
  deletedAt     DateTime?  @map("deleted_at")
  deletedBy     String?    @map("deleted_by") @db.Uuid
  version       Int        @default(1)

  timetable Timetable @relation(fields: [timetableId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])

  @@unique([tenantId, timetableId, dayOfWeek, startTime])
  @@index([timetableId], name: "idx_ts_timetable")
  @@map("timetable_slots")
}

// ---------------------------------------------------------------------------
// Student placement: enrollment + subject registration
// ---------------------------------------------------------------------------

model StudentClassEnrollment {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  institutionId String           @db.Uuid
  studentPersonId String          @map("student_person_id") @db.Uuid
  classId       String           @db.Uuid
  termId        String           @db.Uuid
  enrollmentDate DateTime         @map("enrollment_date") @db.Date
  status        EnrollmentStatus @default(ENROLLED)
  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @updatedAt @map("updated_at")
  updatedBy     String?          @map("updated_by") @db.Uuid
  deletedAt     DateTime?        @map("deleted_at")
  deletedBy     String?          @map("deleted_by") @db.Uuid
  version       Int              @default(1)

  class Class @relation(fields: [classId], references: [id])
  term  Term   @relation(fields: [termId], references: [id])

  subjectRegistrations SubjectRegistration[]
  attendance           Attendance[]
  assignmentSubmissions AssignmentSubmission[]
  assessmentResults    AssessmentResult[]
  results              Result[]
  reportCards          ReportCard[]

  @@unique([tenantId, studentPersonId, classId, termId])
  @@index([studentPersonId], name: "idx_sce_student")
  @@index([classId], name: "idx_sce_class")
  @@index([termId], name: "idx_sce_term")
  @@map("student_class_enrollments")
}

model SubjectRegistration {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  institutionId String             @db.Uuid
  studentClassEnrollmentId String  @db.Uuid
  subjectId     String             @db.Uuid
  registeredAt  DateTime           @default(now()) @map("registered_at")
  status        RegistrationStatus @default(REGISTERED)
  createdAt     DateTime           @default(now()) @map("created_at")
  createdBy     String?            @map("created_by") @db.Uuid
  updatedAt     DateTime           @updatedAt @map("updated_at")
  updatedBy     String?            @map("updated_by") @db.Uuid
  deletedAt     DateTime?          @map("deleted_at")
  deletedBy     String?            @map("deleted_by") @db.Uuid
  version       Int                @default(1)

  enrollment StudentClassEnrollment @relation(fields: [studentClassEnrollmentId], references: [id])
  subject    Subject                @relation(fields: [subjectId], references: [id])

  @@unique([tenantId, studentClassEnrollmentId, subjectId])
  @@index([studentClassEnrollmentId], name: "idx_sr_enrollment")
  @@map("subject_registrations")
}

// ---------------------------------------------------------------------------
// Attendance (no soft delete)
// ---------------------------------------------------------------------------

model Attendance {
  id                       String           @id @default(uuid()) @db.Uuid
  tenantId                 String           @db.Uuid
  institutionId            String           @db.Uuid
  studentClassEnrollmentId String?          @map("student_class_enrollment_id") @db.Uuid
  staffPersonId            String?          @map("staff_person_id") @db.Uuid
  subjectId                String           @db.Uuid
  date                     DateTime         @db.Date
  status                   AttendanceStatus @default(PRESENT)
  attendanceType           AttendanceType   @map("attendance_type")
  notes                    String?          @db.VarChar(500)
  corrected                Boolean          @default(false)
  correctedBy              String?          @map("corrected_by") @db.Uuid
  correctedAt              DateTime?        @map("corrected_at")
  createdAt                DateTime         @default(now()) @map("created_at")
  createdBy                String?          @map("created_by") @db.Uuid
  updatedAt                DateTime         @updatedAt @map("updated_at")
  updatedBy                String?          @map("updated_by") @db.Uuid
  version                  Int              @default(1)

  enrollment StudentClassEnrollment? @relation(fields: [studentClassEnrollmentId], references: [id])
  subject    Subject                  @relation(fields: [subjectId], references: [id])

  @@unique([tenantId, studentClassEnrollmentId, subjectId, date])
  @@index([studentClassEnrollmentId, date], name: "idx_att_student_date")
  @@index([staffPersonId, date], name: "idx_att_staff_date")
  @@index([subjectId, date], name: "idx_att_subject_date")
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Assignment + submission
// ---------------------------------------------------------------------------

model Assignment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  institutionId   String           @db.Uuid
  title           String           @db.VarChar(200)
  description     String?          @db.Text
  subjectId       String           @db.Uuid
  classId         String           @db.Uuid
  termId          String           @db.Uuid
  submissionStart DateTime         @map("submission_start")
  submissionEnd   DateTime         @map("submission_end")
  maxScore        Decimal          @map("max_score") @db.Decimal(10, 2)
  attachments     Json?
  status          AssignmentStatus @default(DRAFT)
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String?          @map("created_by") @db.Uuid
  updatedAt       DateTime         @updatedAt @map("updated_at")
  updatedBy       String?          @map("updated_by") @db.Uuid
  deletedAt       DateTime?        @map("deleted_at")
  deletedBy       String?          @map("deleted_by") @db.Uuid
  version         Int              @default(1)

  subject     Subject                 @relation(fields: [subjectId], references: [id])
  class       Class                   @relation(fields: [classId], references: [id])
  term        Term                    @relation(fields: [termId], references: [id])
  submissions AssignmentSubmission[]

  @@index([classId], name: "idx_asg_class")
  @@index([subjectId], name: "idx_asg_subject")
  @@index([termId], name: "idx_asg_term")
  @@map("assignments")
}

model AssignmentSubmission {
  id                       String           @id @default(uuid()) @db.Uuid
  tenantId                 String           @db.Uuid
  institutionId            String           @db.Uuid
  assignmentId             String           @db.Uuid
  studentClassEnrollmentId String           @db.Uuid
  submittedAt              DateTime         @map("submitted_at")
  content                  String?          @db.Text
  attachments              Json?
  score                    Decimal?         @db.Decimal(10, 2)
  feedback                 String?          @db.Text
  gradedBy                 String?          @map("graded_by") @db.Uuid
  gradedAt                 DateTime?        @map("graded_at")
  status                   SubmissionStatus @default(SUBMITTED)
  createdAt                DateTime         @default(now()) @map("created_at")
  createdBy                String?          @map("created_by") @db.Uuid
  updatedAt                DateTime         @updatedAt @map("updated_at")
  updatedBy                String?          @map("updated_by") @db.Uuid
  deletedAt                DateTime?        @map("deleted_at")
  deletedBy                String?          @map("deleted_by") @db.Uuid
  version                  Int              @default(1)

  assignment Assignment                @relation(fields: [assignmentId], references: [id])
  enrollment StudentClassEnrollment    @relation(fields: [studentClassEnrollmentId], references: [id])

  @@unique([tenantId, assignmentId, studentClassEnrollmentId])
  @@map("assignment_submissions")
}

// ---------------------------------------------------------------------------
// Assessment
// ---------------------------------------------------------------------------

model Assessment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  institutionId   String           @db.Uuid
  title           String           @db.VarChar(200)
  assessmentType  AssessmentType   @map("assessment_type")
  subjectId       String           @db.Uuid
  termId          String           @db.Uuid
  maxScore        Decimal          @map("max_score") @db.Decimal(10, 2)
  weight          Decimal          @db.Decimal(5, 2)
  date            DateTime?        @db.Date
  status          AssessmentStatus @default(DRAFT)
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String?          @map("created_by") @db.Uuid
  updatedAt       DateTime         @updatedAt @map("updated_at")
  updatedBy       String?          @map("updated_by") @db.Uuid
  deletedAt       DateTime?        @map("deleted_at")
  deletedBy       String?          @map("deleted_by") @db.Uuid
  version         Int              @default(1)

  subject Subject            @relation(fields: [subjectId], references: [id])
  term    Term               @relation(fields: [termId], references: [id])
  results AssessmentResult[]

  @@map("assessments")
}

model AssessmentResult {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @db.Uuid
  institutionId            String   @db.Uuid
  assessmentId             String   @db.Uuid
  studentClassEnrollmentId String   @db.Uuid
  score                    Decimal  @db.Decimal(10, 2)
  gradedBy                 String   @map("graded_by") @db.Uuid
  gradedAt                 DateTime @map("graded_at")
  notes                    String?  @db.VarChar(500)
  createdAt                DateTime @default(now()) @map("created_at")
  createdBy                String?  @map("created_by") @db.Uuid
  updatedAt                DateTime @updatedAt @map("updated_at")
  updatedBy                String?  @map("updated_by") @db.Uuid
  deletedAt                DateTime? @map("deleted_at")
  deletedBy                String?  @map("deleted_by") @db.Uuid
  version                  Int      @default(1)

  assessment Assessment              @relation(fields: [assessmentId], references: [id])
  enrollment StudentClassEnrollment  @relation(fields: [studentClassEnrollmentId], references: [id])

  @@unique([tenantId, assessmentId, studentClassEnrollmentId])
  @@index([studentClassEnrollmentId], name: "idx_ar_enrollment")
  @@index([assessmentId], name: "idx_ar_assessment")
  @@map("assessment_results")
}

// ---------------------------------------------------------------------------
// Grading: grade scale, boundary, remark
// ---------------------------------------------------------------------------

model GradeScale {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  institutionId String           @db.Uuid
  name          String           @db.VarChar(50)
  description   String?          @db.VarChar(500)
  status        GradeScaleStatus @default(DRAFT)
  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @updatedAt @map("updated_at")
  updatedBy     String?          @map("updated_by") @db.Uuid
  deletedAt     DateTime?        @map("deleted_at")
  deletedBy     String?          @map("deleted_by") @db.Uuid
  version       Int              @default(1)

  boundaries GradeBoundary[]
  remarks    Remark[]
  results    Result[]
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, name])
  @@map("grade_scales")
}

model GradeBoundary {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  institutionId String   @db.Uuid
  gradeScaleId  String   @db.Uuid
  grade         String   @db.VarChar(10)
  minScore      Decimal  @map("min_score") @db.Decimal(10, 2)
  maxScore      Decimal  @map("max_score") @db.Decimal(10, 2)
  remark        String?  @db.VarChar(200)
  displayOrder  Int      @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?  @map("deleted_by") @db.Uuid
  version       Int      @default(1)

  scale GradeScale @relation(fields: [gradeScaleId], references: [id])

  @@unique([tenantId, gradeScaleId, grade])
  @@map("grade_boundaries")
}

model Remark {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  institutionId String   @db.Uuid
  gradeScaleId  String   @db.Uuid
  minScore      Decimal  @map("min_score") @db.Decimal(10, 2)
  maxScore      Decimal  @map("max_score") @db.Decimal(10, 2)
  remarkText    String   @map("remark_text") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?  @map("deleted_by") @db.Uuid
  version       Int      @default(1)

  scale GradeScale @relation(fields: [gradeScaleId], references: [id])

  @@map("remarks")
}

// ---------------------------------------------------------------------------
// Results + report cards (no soft delete)
// ---------------------------------------------------------------------------

model Result {
  id                       String       @id @default(uuid()) @db.Uuid
  tenantId                 String       @db.Uuid
  institutionId            String       @db.Uuid
  studentClassEnrollmentId String       @db.Uuid
  subjectId                String       @db.Uuid
  termId                   String       @db.Uuid
  totalScore               Decimal      @map("total_score") @db.Decimal(10, 2)
  grade                    String?      @db.VarChar(10)
  remark                   String?      @db.VarChar(200)
  rank                     Int?
  caScore                  Decimal      @map("ca_score") @db.Decimal(10, 2)
  examScore                Decimal      @map("exam_score") @db.Decimal(10, 2)
  gradeScaleId             String       @db.Uuid
  status                   ResultStatus @default(COMPILED)
  versionNumber            Int          @map("version_number") @default(1)
  createdAt                DateTime     @default(now()) @map("created_at")
  createdBy                String?      @map("created_by") @db.Uuid
  updatedAt                DateTime     @updatedAt @map("updated_at")
  updatedBy                String?      @map("updated_by") @db.Uuid
  version                  Int          @default(1)

  enrollment StudentClassEnrollment @relation(fields: [studentClassEnrollmentId], references: [id])
  subject    Subject                @relation(fields: [subjectId], references: [id])
  term       Term                   @relation(fields: [termId], references: [id])
  scale      GradeScale             @relation(fields: [gradeScaleId], references: [id])

  @@unique([tenantId, studentClassEnrollmentId, subjectId, termId])
  @@index([studentClassEnrollmentId], name: "idx_res_enrollment")
  @@index([termId, subjectId], name: "idx_res_term_subject")
  @@map("results")
}

model ReportCard {
  id                       String           @id @default(uuid()) @db.Uuid
  tenantId                 String           @db.Uuid
  institutionId            String           @db.Uuid
  studentClassEnrollmentId String           @db.Uuid
  termId                   String           @db.Uuid
  averageScore             Decimal          @map("average_score") @db.Decimal(10, 2)
  position                 Int?
  totalScore               Decimal          @map("total_score") @db.Decimal(10, 2)
  remarks                  String?          @db.Text
  generatedAt              DateTime         @map("generated_at")
  publishedAt              DateTime?        @map("published_at")
  status                   ReportCardStatus @default(GENERATED)
  createdAt                DateTime         @default(now()) @map("created_at")
  createdBy                String?          @map("created_by") @db.Uuid
  updatedAt                DateTime         @updatedAt @map("updated_at")
  updatedBy                String?          @map("updated_by") @db.Uuid
  version                  Int              @default(1)

  enrollment StudentClassEnrollment @relation(fields: [studentClassEnrollmentId], references: [id])
  term       Term                   @relation(fields: [termId], references: [id])

  @@unique([tenantId, studentClassEnrollmentId, termId])
  @@index([studentClassEnrollmentId], name: "idx_rc_student")
  @@map("report_cards")
}

// ---------------------------------------------------------------------------
// Academic progression
// ---------------------------------------------------------------------------

model AcademicProgression {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  institutionId  String         @db.Uuid
  studentPersonId String        @map("student_person_id") @db.Uuid
  fromClassId    String         @map("from_class_id") @db.Uuid
  toClassId      String?        @map("to_class_id") @db.Uuid
  termId         String         @db.Uuid
  progressionType ProgressionType @map("progression_type")
  criteriaMet    Json?          @map("criteria_met")
  notes          String?        @db.VarChar(500)
  approvedBy     String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  createdBy      String?        @map("created_by") @db.Uuid
  updatedAt      DateTime       @updatedAt @map("updated_at")
  updatedBy      String?        @map("updated_by") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at")
  deletedBy      String?        @map("deleted_by") @db.Uuid
  version        Int            @default(1)

  fromClass Class? @relation("ProgressionFromClass", fields: [fromClassId], references: [id])
  toClass   Class? @relation("ProgressionToClass", fields: [toClassId], references: [id])
  term      Term   @relation(fields: [termId], references: [id])

  @@unique([tenantId, studentPersonId, termId])
  @@index([studentPersonId], name: "idx_ap_student")
  @@map("academic_progressions")
}

// ---------------------------------------------------------------------------
// Academic policy
// ---------------------------------------------------------------------------

model AcademicPolicy {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  institutionId String       @db.Uuid
  policyType    String       @map("policy_type") @db.VarChar(50)
  policyKey     String       @map("policy_key") @db.VarChar(100)
  value         Json
  description   String?      @db.VarChar(500)
  version       Int          @default(1)
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  status        PolicyStatus @default(DRAFT)
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     String?      @map("created_by") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at")
  updatedBy     String?      @map("updated_by") @db.Uuid
  deletedAt     DateTime?    @map("deleted_at")
  deletedBy     String?      @map("deleted_by") @db.Uuid

  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, policyType, policyKey, version])
  @@index([tenantId, institutionId, policyType, policyKey], name: "idx_ap_type_key")
  @@map("academic_policies")
}

// ---------------------------------------------------------------------------
// Summer school (no soft delete on results)
// ---------------------------------------------------------------------------

model SummerSchoolSession {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  institutionId     String            @db.Uuid
  termId            String            @db.Uuid
  name              String            @db.VarChar(100)
  registrationStart DateTime          @map("registration_start") @db.Date
  registrationEnd   DateTime          @map("registration_end") @db.Date
  startDate         DateTime          @map("start_date") @db.Date
  endDate           DateTime          @map("end_date") @db.Date
  examStartDate     DateTime?         @map("exam_start_date") @db.Date
  examEndDate       DateTime?         @map("exam_end_date") @db.Date
  costModel         CostModel         @map("cost_model")
  costAmount        Decimal?          @map("cost_amount") @db.Decimal(10, 2)
  maxGrade          String?           @map("max_grade") @db.VarChar(10)
  eligibleGrades    Json?             @map("eligible_grades")
  status            SummerSchoolStatus @default(CONFIGURED)
  createdAt         DateTime          @default(now()) @map("created_at")
  createdBy         String?           @map("created_by") @db.Uuid
  updatedAt         DateTime          @updatedAt @map("updated_at")
  updatedBy         String?           @map("updated_by") @db.Uuid
  deletedAt         DateTime?         @map("deleted_at")
  deletedBy         String?           @map("deleted_by") @db.Uuid
  version           Int               @default(1)

  term          Term                     @relation(fields: [termId], references: [id])
  registrations SummerSchoolRegistration[]
  institution   Institution              @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, institutionId, termId, name])
  @@map("summer_school_sessions")
}

model SummerSchoolRegistration {
  id                      String               @id @default(uuid()) @db.Uuid
  tenantId                String               @db.Uuid
  institutionId           String               @db.Uuid
  summerSchoolSessionId   String               @db.Uuid
  studentPersonId         String               @map("student_person_id") @db.Uuid
  registeredAt            DateTime             @default(now()) @map("registered_at")
  paymentStatus           String?              @map("payment_status") @db.VarChar(50)
  status                  SSRegistrationStatus @default(REGISTERED)
  createdAt               DateTime             @default(now()) @map("created_at")
  createdBy               String?              @map("created_by") @db.Uuid
  updatedAt               DateTime             @updatedAt @map("updated_at")
  updatedBy               String?              @map("updated_by") @db.Uuid
  deletedAt               DateTime?            @map("deleted_at")
  deletedBy               String?              @map("deleted_by") @db.Uuid
  version                 Int                  @default(1)

  session SummerSchoolSession @relation(fields: [summerSchoolSessionId], references: [id])
  results SummerSchoolResult[]

  @@unique([tenantId, summerSchoolSessionId, studentPersonId])
  @@index([summerSchoolSessionId], name: "idx_ssr_session")
  @@map("summer_school_registrations")
}

model SummerSchoolResult {
  id                        String   @id @default(uuid()) @db.Uuid
  tenantId                  String   @db.Uuid
  institutionId             String   @db.Uuid
  summerSchoolRegistrationId String  @db.Uuid
  subjectId                 String   @db.Uuid
  originalGrade             String   @map("original_grade") @db.VarChar(10)
  newScore                  Decimal? @map("new_score") @db.Decimal(10, 2)
  newGrade                  String?  @map("new_grade") @db.VarChar(10)
  published                 Boolean  @default(false)
  publishedAt               DateTime? @map("published_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  createdBy                 String?  @map("created_by") @db.Uuid
  updatedAt                 DateTime @updatedAt @map("updated_at")
  updatedBy                 String?  @map("updated_by") @db.Uuid
  version                   Int      @default(1)

  registration SummerSchoolRegistration @relation(fields: [summerSchoolRegistrationId], references: [id])
  subject      Subject                  @relation(fields: [subjectId], references: [id])

  @@unique([tenantId, summerSchoolRegistrationId, subjectId])
  @@map("summer_school_results")
}