model Report {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  institutionId String?  @db.Uuid
  name          String
  type          String
  description   String?
  fileUrl       String?
  parameters    String?
  scheduledAt   DateTime?
  generatedAt   DateTime?
  expiresAt     DateTime?
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, institutionId])
  @@index([tenantId, type])
  @@map("reports")
}

model Dashboard {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  description   String?
  config        String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("dashboards")
}

model KPI {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  description   String?
  category      String
  value         Decimal  @db.Decimal(12, 2)
  target        Decimal? @db.Decimal(12, 2)
  unit          String?
  period        String
  date          DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name, period, date])
  @@index([tenantId, category])
  @@map("kpis")
}

model Alert {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  name          String
  description   String?
  severity      AlertSeverity @default(INFO)
  metric        String
  threshold     Decimal       @db.Decimal(12, 2)
  currentValue  Decimal?      @db.Decimal(12, 2)
  isTriggered   Boolean       @default(false)
  triggeredAt   DateTime?
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, severity])
  @@map("alerts")
}

model Trend {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  metric        String
  value         Decimal  @db.Decimal(12, 2)
  changePercent Decimal? @db.Decimal(8, 2)
  period        String
  date          DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([tenantId, metric, period, date])
  @@index([tenantId, metric])
  @@map("trends")
}
