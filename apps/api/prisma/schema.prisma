  deletedAt       DateTime?

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  roles                  UserRoleAssignment[]
  staff                  Staff?
  student                Student?
  parent                 Guardian?
  parentRecord           Parent?
  emailVerificationTokens EmailVerificationToken[]
  passwordHistory        PasswordHistory[]
