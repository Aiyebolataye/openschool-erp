model Session {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String   @db.Uuid
  // Legacy column retained for migration compatibility. B4 session bookkeeping
  // never writes it; new rows leave it NULL (kept NULL-able + UNIQUE, unused).
  token            String?  @unique
  accessTokenHash  String   @db.VarChar(64)
  refreshTokenHash String   @unique @db.VarChar(64)
  isActive         Boolean  @default(true)
  lastActivityAt   DateTime
  deviceInfo       Json?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  refreshTokenHistory RefreshTokenHistory[]

  @@unique([tenantId, userId, accessTokenHash])
  @@index([userId])
  @@index([isActive, expiresAt])
  @@map("sessions")
}

/// Append-only ledger of consumed refresh-token hashes (D-05 reuse detection).
/// Only hashes are stored — never raw refresh tokens. Current tokens live in
/// `sessions.refreshTokenHash`; a token handed in that matches neither that
/// column nor this ledger is simply invalid (never-issued).
model RefreshTokenHistory {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @db.Uuid
  refreshTokenHash String   @unique @db.VarChar(64)
  createdAt        DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, refreshTokenHash])
  @@index([sessionId])
  @@map("refresh_token_history")
}

model UserInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  email      String           @db.VarChar(255)
  token      String           @db.VarChar(255)
  roleId     String?          @db.Uuid
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role?  @relation(fields: [roleId], references: [id])

  @@unique([tenantId, email, token])
  @@index([tenantId, status])
  @@map("user_invitations")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  token      String    @db.VarChar(255)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verification_tokens")
}

// Append-only authentication attempt record (D-09). Never updated or deleted;
// a successful login only clears the ACTIVE failure window/lock state.
model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  email         String   @db.VarChar(255)
  userId        String?  @db.Uuid
  success       Boolean
  failureReason String?  @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, email, createdAt])
  @@map("login_attempts")
}

model PasswordPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  minLength         Int      @default(8)
  requireUppercase  Boolean  @default(true)
  requireLowercase  Boolean  @default(true)
  requireDigit      Boolean  @default(true)
  requireSpecialChar Boolean @default(true)
  historyCount      Int      @default(12)
  expiryDays        Int      @default(90)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@map("password_policies")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_history")
}

model OrganizationMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("organization_memberships")
}

model InstitutionMembership {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  institutionId String           @db.Uuid
  userId        String           @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([tenantId, institutionId, userId])
  @@index([tenantId, institutionId, status])
  @@index([userId])
  @@map("institution_memberships")
}

model OnboardingLink {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  userId        String          @db.Uuid
  institutionId String?         @db.Uuid
  email         String          @db.VarChar(255)
  token         String          @db.VarChar(255)
  status        OnboardingStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])

  @@unique([tenantId, userId, token])
  @@index([userId])
  @@map("onboarding_links")
}


// --- Domain: institution ---

model Tenant {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  subdomain     String?       @unique
  logoUrl       String?
  primaryColor  String?       @default("#2563EB")
  subscription  String        @default("free")
  status        UserRoleStatus @default(ACTIVE)
  maxStudents   Int           @default(500)
  maxStaff      Int           @default(100)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  institutions   Institution[]
  users          User[]
  featureFlags   FeatureFlag[]
  auditLogs      AuditLog[]
  userInvitations UserInvitation[]
  passwordPolicies PasswordPolicy[]
  organizationMemberships OrganizationMembership[]
  institutionMemberships  InstitutionMembership[]
  onboardingLinks         OnboardingLink[]
  loginAttempts           LoginAttempt[]
  sessions                Session[]

  @@index([slug])
  @@map("tenants")
}

model Institution {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  name            String
  code            String
  status          InstitutionStatus @default(ACTIVE)
  logoUrl         String?
  address         String?
  city            String?
  state           String?
  country         String   @default("NG")
  phone           String?
  email           String?
  website         String?
  motto           String?
  timezone        String   @default("Africa/Lagos")
  currency        String   @default("NGN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  departments     Department[]
  academicYears   AcademicYear[]
  students        Student[]
  staff           Staff[]
  classes         Class[]
  curricula       Curriculum[]
  subjects        Subject[]
  feeStructures   FeeStructure[]
  transportRoutes TransportRoute[]
  hostels         Hostel[]
  memberships     InstitutionMembership[]
  onboardingLinks OnboardingLink[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("institutions")
}

model Department {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  institutionId   String   @db.Uuid
  name            String
  code            String
  description     String?
  headStaffId     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  institution     Institution @relation(fields: [institutionId], references: [id])
  subjects        Subject[]

  @@unique([tenantId, institutionId, code])
  @@index([tenantId, institutionId])
  @@map("departments")
}


// --- Domain: operations ---

model Attendance {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  classId       String           @db.Uuid
  studentId     String           @db.Uuid
  termId        String           @db.Uuid
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  remarks       String?
  recordedBy    String?          @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  class         Class    @relation(fields: [classId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])
  term          Term     @relation(fields: [termId], references: [id])

  @@unique([classId, studentId, date])
  @@index([tenantId, classId, date])
  @@index([tenantId, studentId])
  @@map("attendance")
}

model Hostel {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  institutionId   String      @db.Uuid
  name            String
  code            String
  gender          HostelGender
  capacity        Int
  wardenStaffId   String?     @db.Uuid
  phone           String?
  status          UserRoleStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  institution     Institution @relation(fields: [institutionId], references: [id])
  allocations     HostelAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId, institutionId])
  @@map("hostels")
}

model HostelAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  hostelId      String   @db.Uuid
  studentId     String   @db.Uuid
  roomNumber    String
  bedNumber     String?
  startDate     DateTime @default(now())
  endDate       DateTime?
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  hostel        Hostel   @relation(fields: [hostelId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])

  @@unique([hostelId, roomNumber, bedNumber])
  @@index([tenantId, hostelId])
  @@index([tenantId, studentId])
  @@map("hostel_allocations")
}

model TransportRoute {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  institutionId String   @db.Uuid
  name          String
  code          String
  description   String?
  stops         String[]
  distance      Decimal? @db.Decimal(8, 2)
  estimatedTime Int?
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  institution   Institution @relation(fields: [institutionId], references: [id])
  allocations   TransportAllocation[]
  vehicles      Vehicle[]

  @@unique([tenantId, code])
  @@index([tenantId, institutionId])
  @@map("transport_routes")
}

model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  routeId       String?  @db.Uuid
  plateNumber   String
  type          String
  capacity      Int
  driverName    String?
  driverPhone   String?
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  route         TransportRoute? @relation(fields: [routeId], references: [id])

  @@unique([tenantId, plateNumber])
  @@index([tenantId])
  @@map("vehicles")
}

model TransportAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  routeId       String   @db.Uuid
  studentId     String   @db.Uuid
  startDate     DateTime @default(now())
  endDate       DateTime?
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  route         TransportRoute @relation(fields: [routeId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])

  @@unique([routeId, studentId])
  @@index([tenantId, routeId])
  @@map("transport_allocations")
}

model InventoryItem {
