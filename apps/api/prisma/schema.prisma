  tenantId      String   @db.Uuid
  institutionId String   @db.Uuid
  name          String
  category      String
  description   String?
  quantity      Int      @default(0)
  unitPrice     Decimal? @db.Decimal(10, 2)
  location      String?
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, institutionId, name])
  @@index([tenantId, institutionId])
  @@map("inventory_items")
}

model MaintenanceRequest {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  institutionId String       @db.Uuid
  requestedBy   String?      @db.Uuid
  assignedTo    String?      @db.Uuid
  termId        String?      @db.Uuid
  title         String
  description   String?
  priority      String       @default("medium")
  status        TicketStatus @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  staff         Staff?     @relation(fields: [requestedBy], references: [id])
  term          Term?      @relation(fields: [termId], references: [id])

  @@index([tenantId, institutionId])
  @@index([tenantId, status])
  @@map("maintenance_requests")
}

model LeaveRequest {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  staffId       String       @db.Uuid
  termId        String?      @db.Uuid
  leaveType     String
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  reason        String
  status        TicketStatus @default(OPEN)
  approvedBy    String?      @db.Uuid
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  staff         Staff    @relation(fields: [staffId], references: [id])
  term          Term?    @relation(fields: [termId], references: [id])

  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("leave_requests")
}


// --- Domain: people ---

model Student {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  institutionId   String          @db.Uuid
  userId          String?         @unique @db.Uuid
  studentNumber   String
  internalEmail   String?
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime?
  gender          Gender
  bloodGroup      String?
  nationality     String?         @default("Nigerian")
  stateOfOrigin   String?
  address         String?
  phone           String?
  admissionDate   DateTime        @default(now())
  status          EnrollmentStatus @default(ACTIVE)
  profileImageUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  institution     Institution     @relation(fields: [institutionId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])
  enrollments     Enrollment[]
  invoices        Invoice[]
  attendance      Attendance[]
  submissions     Submission[]
  documents       Document[]
  relationships   StudentGuardianRelationship[]
  libraryLoans    BookLoan[]
  hostelAllocations HostelAllocation[]
  transportAllocations TransportAllocation[]
  assignments     Assignment[]

  @@unique([tenantId, institutionId, studentNumber])
  @@unique([tenantId, institutionId, internalEmail])
  @@index([tenantId, institutionId])
  @@index([tenantId, status])
  @@map("students")
}

model Staff {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  institutionId   String          @db.Uuid
  userId          String?         @unique @db.Uuid
  staffNumber     String
  internalEmail   String?
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime?
  gender          Gender
  phone           String?
  email           String?
  qualification   String?
  specialization  String?
  hireDate        DateTime        @default(now())
  employmentType  String          @default("full_time")
  department      String?
  position        String?
  status          UserRoleStatus  @default(ACTIVE)
  profileImageUrl String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  institution     Institution     @relation(fields: [institutionId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])
  classes         Class[]
  classTeacherOf  Class[]         @relation("ClassTeacher")
  grades          Grade[]
  maintenanceRequests MaintenanceRequest[]
  leaveRequests   LeaveRequest[]

  @@unique([tenantId, institutionId, staffNumber])
  @@unique([tenantId, institutionId, internalEmail])
  @@index([tenantId, institutionId])
  @@map("staff")
}

model Guardian {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  userId        String?  @unique @db.Uuid
  firstName     String
  lastName      String
  email         String
  phone         String
  address       String?
  occupation    String?
  relationship  String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  user          User?    @relation(fields: [userId], references: [id])
  relationships StudentGuardianRelationship[]

  @@index([tenantId])
  @@map("guardians")
}

model StudentGuardianRelationship {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  studentId   String   @db.Uuid
  guardianId  String   @db.Uuid
  relationship String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id])
  guardian    Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([tenantId])
  @@map("student_guardian_relationships")
}


// --- Domain: platform ---

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  key         String
  value       String
  category    String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, category])
  @@map("system_configs")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  percentage  Int      @default(100)
  rules       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("feature_flags")
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @map("tenant_id") @db.Uuid
  actorId          String?  @map("actor_id") @db.Uuid
  actorEmail       String?  @map("actor_email") @db.VarChar(255)
  action           String
  entityType       String   @map("entity_type")
  entityId         String?  @map("entity_id")
  oldValues        String?  @map("old_values")
  newValues        String?  @map("new_values")
  changes          Json?
  contextIp        String?  @map("context_ip") @db.VarChar(45)
  contextUserAgent String?  @map("context_user_agent")
  correlationId    String?  @map("correlation_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId])
  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
